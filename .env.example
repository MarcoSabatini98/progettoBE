# Copia questo file in .env e compila i valori.
# Le variabili senza valore sono facoltative: la relativa funzione resta
# disattivata finché non vengono compilate.

# --- Applicazione ------------------------------------------------------------
NODE_ENV=development
PORT=3000
# URL pubblico del backend (link nelle email, webhook, export iCal)
APP_URL=http://localhost:3000
# URL del frontend Angular (CORS e link nelle email)
FRONTEND_URL=http://localhost:4200
# Proxy davanti all'app in produzione: 1 con solo Render, 2 con Cloudflare + Render
PROXY_FIDATI=1
# error | warn | info | http | debug  (predefinito: debug in sviluppo, info in produzione)
LOG_LEVEL=

# --- Database (MariaDB / MySQL) ----------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_NAME=progettobe
DB_USER=root
DB_PASSWORD=
DB_POOL_MAX=10
# true per stampare le query SQL nel log (solo debug)
DB_LOG=false

# --- Autenticazione (segreti di almeno 32 caratteri, tutti diversi) ----------
# Genera con: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_CHAT_SECRET=
JWT_ACCESS_DURATA=15m
REFRESH_DURATA_GIORNI=30

# --- File caricati -----------------------------------------------------------
UPLOAD_DIR=uploads
UPLOAD_MAX_MB=5
# Video di sfondo della home. Il caricamento deve finire entro 3 minuti
# (requestTimeout in server.js): 50 MB vogliono almeno ~2,5 Mbit/s in upload.
UPLOAD_VIDEO_MAX_MB=50

# --- Email (SMTP) ------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
# es. "Hotel Bellavista <prenotazioni@hotelbellavista.it>"
MAIL_MITTENTE=

# --- Stripe ------------------------------------------------------------------
# Carta, Google Pay, Apple Pay, Klarna ecc.: si attivano dalla dashboard Stripe
# (Impostazioni > Metodi di pagamento), il codice non va toccato.
# Webhook: <APP_URL>/api/pagamenti/webhook/stripe con gli eventi
#   checkout.session.completed, checkout.session.async_payment_succeeded,
#   checkout.session.async_payment_failed, checkout.session.expired
# Con la chiave segreta, il segreto del webhook (whsec_...) è obbligatorio.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- PayPal ------------------------------------------------------------------
# Webhook: <APP_URL>/api/pagamenti/webhook/paypal con gli eventi
#   CHECKOUT.ORDER.APPROVED, PAYMENT.CAPTURE.COMPLETED, PAYMENT.CAPTURE.DENIED
# Con client id e segreto, il PAYPAL_WEBHOOK_ID è obbligatorio.
PAYPAL_AMBIENTE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

# --- Alloggiati Web (Polizia di Stato) ---------------------------------------
ALLOGGIATI_UTENTE=
ALLOGGIATI_PASSWORD=
ALLOGGIATI_WSKEY=

# --- Seed (npm run db:seed) ----------------------------------------------------
# Primo amministratore: creato solo se non ne esiste già uno
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NOME=
SEED_ADMIN_COGNOME=
# Nome della struttura: scritto nella barra del sito quando manca il logo
# (si cambia poi da Gestionale > Impostazioni)
SEED_STRUTTURA_NOME=
